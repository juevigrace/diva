---
import AppLayout from '@layouts/AppLayout.astro';
import HealthView from '@components/app/HealthView';

import { t } from '@lib/i18n/t';

const { state, preferences } = Astro.locals;
const canEdit = (state?.verified && preferences?.onboarding_completed) ?? false;
---

<AppLayout
  title={t('page.health.title', Astro.locals.lang)}
  heading={t('nav.health', Astro.locals.lang)}
  description={t('page.health.desc', Astro.locals.lang)}
>
  <HealthView isVerified={canEdit} lang={Astro.locals.lang} client:load />
</AppLayout>
