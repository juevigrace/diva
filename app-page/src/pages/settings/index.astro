---
import AppLayout from '@layouts/AppLayout.astro';
import SettingsContent from '@components/app/SettingsContent';
import { apiFetch } from '@api/lib/fetch';
import { t } from '@lib/i18n/t';
import type { SessionResponse } from 'diva-types/auth/responses';

const { user, state } = Astro.locals;
const auth = await Astro.session.get<SessionResponse>('auth');

let preferencesList: Record<string, any>[] | null = null;

if (state?.verified && user) {
  try {
    const prefRes = await apiFetch(`/api/user/${user.userId}/preferences`, { token: auth!.access_token });
    if (prefRes.ok) {
      preferencesList = prefRes.json.data;
    }
  } catch (_) {}
}

const preferences = preferencesList && preferencesList.length > 0 ? preferencesList[0] : null;
---

<AppLayout
  title={t('page.settings.title', Astro.locals.lang)}
  heading="Settings"
  description={t('page.settings.desc', Astro.locals.lang)}
>
  <SettingsContent uid={user!.userId} initialPreferences={preferences} isVerified={state?.verified ?? false} lang={Astro.locals.lang} client:load />
</AppLayout>
