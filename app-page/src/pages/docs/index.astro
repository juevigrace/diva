---
import DocsLayout from '@layouts/DocsLayout.astro';
import CodeBlock from '@components/docs/CodeBlock.astro';
import { t } from '@lib/i18n/t';

const lang = Astro.locals.lang;
---

<DocsLayout
  title={t('page.docs.title', lang)}
  description={t('page.docs.desc', lang)}
>
  <div class="mx-auto max-w-3xl">
    <h1 class="text-4xl font-bold tracking-tight">{t('docs.title', lang)}</h1>
    <p class="text-muted-foreground mt-4 text-lg">{t('docs.subtitle', lang)}</p>

    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      <a
        href="/docs/getting-started"
        class="group border-border bg-card hover:border-primary/50 rounded-xl border p-6 shadow-sm transition-colors"
      >
        <h2 class="group-hover:text-primary font-semibold">{t('docs.gettingStarted', lang)}</h2>
        <p class="text-muted-foreground mt-2 text-sm">
          {t('docs.cardGettingStartedDesc', lang)}
        </p>
      </a>
      <a
        href="/docs/components"
        class="group border-border bg-card hover:border-primary/50 rounded-xl border p-6 shadow-sm transition-colors"
      >
        <h2 class="group-hover:text-primary font-semibold">{t('docs.components', lang)}</h2>
        <p class="text-muted-foreground mt-2 text-sm">
          {t('docs.cardComponentsDesc', lang)}
        </p>
      </a>
      <a
        href="/docs/api"
        class="group border-border bg-card hover:border-primary/50 rounded-xl border p-6 shadow-sm transition-colors"
      >
        <h2 class="group-hover:text-primary font-semibold">{t('docs.api', lang)}</h2>
        <p class="text-muted-foreground mt-2 text-sm">{t('docs.cardApiDesc', lang)}</p>
      </a>
      <div class="border-border bg-card rounded-xl border p-6 shadow-sm">
        <h2 class="font-semibold">{t('docs.quickInstall', lang)}</h2>
        <div class="mt-3">
          <CodeBlock code="bun add diva-ui" lang="bash" />
        </div>
      </div>
    </div>
  </div>
</DocsLayout>
