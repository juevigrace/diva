---
import DocsLayout from '@layouts/DocsLayout.astro';
import TocSidebar from '@components/docs/TocSidebar.astro';
import CodeBlock from '@components/docs/CodeBlock.astro';
import { t } from '@lib/i18n/t';

const lang = Astro.locals.lang;
const nextStepsBody = t('docs.gsNextStepsBody', lang, { link: '' }).replace(
  '{link}',
  `<a href="/docs/components" class="text-primary hover:text-primary/80 underline underline-offset-4">${t('docs.components', lang)}</a>`,
);
---

<DocsLayout
  title={t('page.gettingStarted.title', lang)}
  description={t('page.gettingStarted.desc', lang)}
>
  <div class="flex">
    <main class="max-w-3xl min-w-0 flex-1">
      <h1 id="introduction" class="text-4xl font-bold tracking-tight">{t('docs.gettingStarted', lang)}</h1>
      <p class="text-muted-foreground mt-4 text-lg">
        {t('docs.gsIntro', lang)}
      </p>

      <h2 id="installation" class="mt-12 text-2xl font-bold tracking-tight">{t('docs.installation', lang)}</h2>
      <p class="text-muted-foreground mt-4 leading-relaxed">
        {t('docs.gsInstallBody', lang)}
      </p>
      <div class="mt-4">
        <CodeBlock code="bun add diva-ui@workspace:*" lang="bash" />
      </div>

      <h3 id="quick-start" class="mt-8 text-xl font-semibold tracking-tight">{t('docs.quickStart', lang)}</h3>
      <p class="text-muted-foreground mt-3 leading-relaxed">
        {t('docs.gsQuickStartBody', lang)}
      </p>
      <div class="mt-4">
        <CodeBlock
          code={`---
import Layout from '../layouts/Layout.astro';
---

<Layout title="My Page">
  <h1>Hello, Diva!</h1>
</Layout>`}
          lang="astro"
        />
      </div>

      <h3 id="project-structure" class="mt-8 text-xl font-semibold tracking-tight">
        {t('docs.projectStructure', lang)}
      </h3>
      <p class="text-muted-foreground mt-3 leading-relaxed">
        {t('docs.gsProjectStructureBody', lang)}
      </p>
      <div class="mt-4">
        <CodeBlock
          code={`my-project/
├── app-page/          # Dashboard, docs, landing pages
├── lib/
│   ├── diva-ui/       # Shared component library
│   └── diva-types/    # Shared TypeScript types
└── package.json`}
          lang="text"
        />
      </div>

      <div class="border-border bg-card mt-12 rounded-lg border p-6">
        <p class="text-sm font-medium">💡 {t('docs.nextSteps', lang)}</p>
        <p class="text-muted-foreground mt-2 text-sm" set:html={nextStepsBody} />
      </div>
    </main>
    <TocSidebar lang={lang}
      headings={[
        { id: 'introduction', label: t('docs.gettingStarted', lang), level: 1 },
        { id: 'installation', label: t('docs.installation', lang), level: 2 },
        { id: 'quick-start', label: t('docs.quickStart', lang), level: 3 },
        { id: 'project-structure', label: t('docs.projectStructure', lang), level: 3 },
      ]}
    />
  </div>
</DocsLayout>
