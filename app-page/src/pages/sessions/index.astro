---
import AppLayout from '@layouts/AppLayout.astro';
import SessionsManager from '@components/app/SessionsManager';
import { apiFetch } from '@api/lib/fetch';
import { t } from '@lib/i18n/t';
import type { SessionResponse } from 'diva-types/auth/responses';

const { user, state } = Astro.locals;
const auth = await Astro.session.get<SessionResponse>('auth');

let sessions: Record<string, any>[] | null = null;

if (state?.verified && user) {
  try {
    const res = await apiFetch(`/api/user/${user.userId}/sessions`, { token: auth!.access_token });
    if (res.ok) {
      sessions = res.json.data;
    }
  } catch (_) {}
}
---

<AppLayout title={t('page.sessions.title', Astro.locals.lang)} heading={t('nav.sessions', Astro.locals.lang)} description={t('page.sessions.desc', Astro.locals.lang)}>
  {user && auth && <SessionsManager uid={user.userId} initialSessions={sessions} currentSessionId={auth.session_id} isVerified={state?.verified ?? false} lang={Astro.locals.lang} client:load />}
</AppLayout>
