---
import AppLayout from '@layouts/AppLayout.astro';
import AuditLog from '@components/app/AuditLog';

import { t } from '@lib/i18n/t';

const { user, state } = Astro.locals;
const isVerified = !!state?.verified;
---

<AppLayout title={t('page.audit.title', Astro.locals.lang)} heading={t('nav.auditLog', Astro.locals.lang)} description={t('page.audit.desc', Astro.locals.lang)}>
  {user && <AuditLog uid={user.id} isVerified={isVerified} lang={Astro.locals.lang} client:load />}
</AppLayout>
