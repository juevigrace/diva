---
import AppLayout from '@layouts/AppLayout.astro';
import DevicesManager from '@components/app/DevicesManager';
import { apiFetch } from '@api/lib/fetch';
import { t } from '@lib/i18n/t';

const { session } = Astro.locals;
const uid = session!.userId;
const isVerified = session!.isVerified;

let devices: Record<string, any>[] | null = null;

if (isVerified) {
  try {
    const res = await apiFetch(`/api/user/${uid}/devices`, { token: session!.accessToken });
    if (res.ok) {
      devices = res.json.data;
    }
  } catch (_) {}
}
---

<AppLayout title={t('page.devices.title', Astro.locals.lang)} heading="Devices" description={t('page.devices.desc', Astro.locals.lang)}>
  <DevicesManager uid={uid} initialDevices={devices} isVerified={isVerified} lang={Astro.locals.lang} client:load />
</AppLayout>
