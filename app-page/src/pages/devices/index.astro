---
import AppLayout from '@layouts/AppLayout.astro';
import DevicesManager from '@components/app/DevicesManager';
import { apiFetch } from '@api/lib/fetch';
import { t } from '@lib/i18n/t';
import type { SessionResponse } from 'diva-types/auth/responses';

const auth = await Astro.session.get<SessionResponse>('auth');

let devices: Record<string, any>[] | null = null;

try {
  const res = await apiFetch('/api/devices', { token: auth!.access_token });
  if (res.ok) {
    devices = res.json.data;
  }
} catch (_) {}
---

<AppLayout title={t('page.devices.title', Astro.locals.lang)} heading={t('nav.devices', Astro.locals.lang)} description={t('page.devices.desc', Astro.locals.lang)}>
  <DevicesManager initialDevices={devices} lang={Astro.locals.lang} client:load />
</AppLayout>
