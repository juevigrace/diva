---
import '@styles/global.css';
import Layout from '@layouts/Layout.astro';
import DocSidebar from '@components/docs/DocSidebar.astro';

export interface Props {
  title?: string;
  description?: string;
}

const { title = 'Docs — Diva', description } = Astro.props;
const lang = Astro.locals.lang || 'en';
---

<Layout title={title} description={description}>
  <div class="flex min-h-screen" transition:animate="slide">
    <DocSidebar lang={lang} />
    <div class="flex-1">
      <div class="flex">
        <main class="min-w-0 flex-1 px-6 py-10 md:px-10">
          <slot />
        </main>
      </div>
    </div>
  </div>
</Layout>
