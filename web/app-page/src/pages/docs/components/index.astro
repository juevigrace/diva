---
import DocsLayout from '@layouts/DocsLayout.astro';
import TocSidebar from '@components/docs/TocSidebar.astro';
import CodeBlock from '@components/docs/CodeBlock.astro';
import { t } from '@lib/i18n/t';

const lang = Astro.locals.lang;
---

<DocsLayout
  title={t('page.components.title', lang)}
  description={t('page.components.desc', lang)}
>
  <div class="flex">
    <main class="max-w-3xl min-w-0 flex-1">
      <h1 id="overview" class="text-4xl font-bold tracking-tight">{t('docs.components', lang)}</h1>
      <p class="text-muted-foreground mt-4 text-lg">
        {t('docs.compIntro', lang)}
      </p>

      <h2 id="button" class="mt-12 text-2xl font-bold tracking-tight">{t('docs.button', lang)}</h2>
      <p class="text-muted-foreground mt-4 leading-relaxed">
        {t('docs.buttonDesc', lang)}
      </p>
      <div class="mt-4">
        <CodeBlock
          code={`import { Button } from 'diva-ui/components/button'

<Button variant="default">Default</Button>
<Button variant="secondary">Secondary</Button>
<Button variant="destructive">Destructive</Button>
<Button variant="outline">Outline</Button>
<Button variant="ghost">Ghost</Button>
<Button variant="link">Link</Button>`}
          lang="tsx"
        />
      </div>

      <h2 id="card" class="mt-12 text-2xl font-bold tracking-tight">{t('docs.card', lang)}</h2>
      <p class="text-muted-foreground mt-4 leading-relaxed">
        {t('docs.cardDesc', lang)}
      </p>
      <div class="mt-4">
        <CodeBlock
          code={`import { Card, CardHeader, CardTitle, CardDescription, CardContent, CardFooter } from 'diva-ui/components/card'

<Card>
  <CardHeader>
    <CardTitle>Card Title</CardTitle>
    <CardDescription>Card Description</CardDescription>
  </CardHeader>
  <CardContent>
    <p>Card Content</p>
  </CardContent>
  <CardFooter>
    <Button>Action</Button>
  </CardFooter>
</Card>`}
          lang="tsx"
        />
      </div>

      <h2 id="forms" class="mt-12 text-2xl font-bold tracking-tight">{t('docs.forms', lang)}</h2>
      <p class="text-muted-foreground mt-4 leading-relaxed">
        {t('docs.formsDesc', lang)}
      </p>
      <div class="mt-4">
        <CodeBlock
          code={`import { Input } from 'diva-ui/components/input'
import { Label } from 'diva-ui/components/label'
import { Checkbox } from 'diva-ui/components/checkbox'
import { Switch } from 'diva-ui/components/switch'

<Label htmlFor="email">Email</Label>
<Input id="email" type="email" placeholder="you@example.com" />
<Checkbox id="terms" />
<Switch checked={true} />`}
          lang="tsx"
        />
      </div>

      <h2 id="navigation" class="mt-12 text-2xl font-bold tracking-tight">{t('docs.navigation', lang)}</h2>
      <p class="text-muted-foreground mt-4 leading-relaxed">
        {t('docs.navigationDesc', lang)}
      </p>

      <h2 id="overlay" class="mt-12 text-2xl font-bold tracking-tight">{t('docs.overlays', lang)}</h2>
      <p class="text-muted-foreground mt-4 leading-relaxed">
        {t('docs.overlaysDesc', lang)}
      </p>
    </main>
    <TocSidebar lang={lang}
      headings={[
        { id: 'overview', label: t('docs.overview', lang), level: 1 },
        { id: 'button', label: t('docs.button', lang), level: 2 },
        { id: 'card', label: t('docs.card', lang), level: 2 },
        { id: 'forms', label: t('docs.forms', lang), level: 2 },
        { id: 'navigation', label: t('docs.navigation', lang), level: 2 },
        { id: 'overlay', label: t('docs.overlays', lang), level: 2 },
      ]}
    />
  </div>
</DocsLayout>
