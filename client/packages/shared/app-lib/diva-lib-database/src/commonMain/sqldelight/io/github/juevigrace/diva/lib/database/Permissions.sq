upsert:
INSERT OR REPLACE INTO diva_permissions (id, name, description, action, role_level, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

deleteAll:
DELETE FROM diva_permissions;

findAll:
SELECT
  id,
  name,
  description,
  action,
  role_level AS roleLevel,
  created_at AS createdAt,
  updated_at AS updatedAt,
  deleted_at AS deletedAt
FROM diva_permissions;

findOneById:
SELECT
  id,
  name,
  description,
  action,
  role_level AS roleLevel,
  created_at AS createdAt,
  updated_at AS updatedAt,
  deleted_at AS deletedAt
FROM diva_permissions
WHERE id = ?;

deleteById:
DELETE FROM diva_permissions
WHERE id = ?;
