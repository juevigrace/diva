upsert:
INSERT OR REPLACE INTO diva_action (id, name, user_id)
VALUES (?, ?, ?);

delete:
DELETE FROM diva_action;

findAll:
SELECT id, name, user_id AS userId
FROM diva_action
WHERE user_id = ?;

findOneByAction:
SELECT id, name, user_id AS userId
FROM diva_action
WHERE user_id = ? AND name = ?;

findOne:
SELECT id, name, user_id AS userId
FROM diva_action
WHERE id = ?;

deleteOne:
DELETE FROM diva_action
WHERE id = ?;
