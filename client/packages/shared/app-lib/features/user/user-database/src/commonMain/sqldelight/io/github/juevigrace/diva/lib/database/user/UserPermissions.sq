upsert:
INSERT OR REPLACE INTO diva_user_permissions (permission_id, user_id, granted_by, granted, granted_at, expires_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

delete:
DELETE FROM diva_user_permissions;

findAll:
SELECT
  permission_id AS permissionId,
  user_id AS userId,
  granted_by AS grantedBy,
  granted,
  granted_at AS grantedAt,
  expires_at AS expiresAt,
  updated_at AS updatedAt
FROM diva_user_permissions
WHERE user_id = ?;

findOne:
SELECT
  permission_id AS permissionId,
  user_id AS userId,
  granted_by AS grantedBy,
  granted,
  granted_at AS grantedAt,
  expires_at AS expiresAt,
  updated_at AS updatedAt
FROM diva_user_permissions
WHERE permission_id = ? AND user_id = ?;

deleteOne:
DELETE FROM diva_user_permissions
WHERE permission_id = ? AND user_id = ?;
