-- Shared entry rows (directories and files): the storage picks insert or update
-- by path so the UUID id of an existing row survives rescans and children's
-- parent_id references stay valid. File rows additionally live in diva_file
-- (see File.sq); deleting an entry cascades to its file row.
--
-- Every read LEFT JOINs the parent row (p) so parent_path/parent_name fill
-- the EntryRef without extra lookups. The file row (f) is LEFT JOINed so
-- size_bytes/mime_type are NULL for directories, populated for files.

-- ============================ WRITES ============================

insert:
INSERT INTO diva_entry(id, name, path, parent_id, last_modified, hidden, scanned_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

update:
UPDATE diva_entry
SET name = ?,
    parent_id = ?,
    last_modified = ?,
    hidden = ?,
    scanned_at = ?,
    updated_at = ?
WHERE id = ?;

-- ============================ DELETES ============================

deleteOne:
DELETE FROM diva_entry
WHERE id = ?;

delete:
DELETE FROM diva_entry;

deleteStaleChildren:
DELETE FROM diva_entry
WHERE parent_id IS ?
  AND scanned_at < ?;

-- ============================ LOOKUPS ============================

findByPath:
SELECT id
FROM diva_entry
WHERE path = ?;

-- ============================ READS (unified 15-col projection) ============================

findAll:
SELECT e.id, e.name, e.path, e.parent_id, e.last_modified, e.hidden, e.scanned_at, e.created_at, e.updated_at,
       p.path AS parent_path, p.name AS parent_name,
       f.size_bytes, f.mime_type, f.category, f.content_uri
FROM diva_entry AS e
LEFT JOIN diva_file AS f ON f.dir_id = e.id
LEFT JOIN diva_entry AS p ON e.parent_id = p.id
ORDER BY e.name ASC;

findById:
SELECT e.id, e.name, e.path, e.parent_id, e.last_modified, e.hidden, e.scanned_at, e.created_at, e.updated_at,
       p.path AS parent_path, p.name AS parent_name,
       f.size_bytes, f.mime_type, f.category, f.content_uri
FROM diva_entry AS e
LEFT JOIN diva_file AS f ON f.dir_id = e.id
LEFT JOIN diva_entry AS p ON e.parent_id = p.id
WHERE e.id = ?;

findByParent:
SELECT e.id, e.name, e.path, e.parent_id, e.last_modified, e.hidden, e.scanned_at, e.created_at, e.updated_at,
       p.path AS parent_path, p.name AS parent_name,
       f.size_bytes, f.mime_type, f.category, f.content_uri
FROM diva_entry AS e
LEFT JOIN diva_file AS f ON f.dir_id = e.id
LEFT JOIN diva_entry AS p ON e.parent_id = p.id
WHERE e.parent_id IS ?
ORDER BY e.name ASC;
