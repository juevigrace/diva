upsert:
INSERT OR REPLACE INTO diva_user (id, username, email, phone_number, password_hash, role, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

delete:
DELETE FROM diva_user;

findAll:
SELECT
  id,
  username,
  email,
  phone_number AS phoneNumber,
  password_hash AS passwordHash,
  role,
  created_at AS createdAt,
  updated_at AS updatedAt,
  deleted_at AS deletedAt
FROM diva_user;

findOne:
SELECT
  id,
  username,
  email,
  phone_number AS phoneNumber,
  password_hash AS passwordHash,
  role,
  created_at AS createdAt,
  updated_at AS updatedAt,
  deleted_at AS deletedAt
FROM diva_user
WHERE id = ?;

deleteOne:
DELETE FROM diva_user
WHERE id = ?;
