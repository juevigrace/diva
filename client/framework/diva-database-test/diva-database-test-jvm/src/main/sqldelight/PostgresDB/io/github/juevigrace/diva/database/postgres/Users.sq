CREATE TABLE users (
    id INTEGER PRIMARY KEY GENERATED ALWAYS AS IDENTITY,
    name TEXT NOT NULL,
    email TEXT NOT NULL UNIQUE,
    created_at INTEGER NOT NULL DEFAULT 0
);

insertUser:
INSERT INTO users(name, email, created_at)
VALUES (?, ?, ?);

selectAll:
SELECT * FROM users;

selectById:
SELECT * FROM users
WHERE id = ?;

selectByEmail:
SELECT * FROM users
WHERE email = ?;

deleteById:
DELETE FROM users
WHERE id = ?;