{
  "name": "diva",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.2"
  },
  "scripts": {
    "dev": "pnpm turbo dev",
    "build": "pnpm turbo build",
    "stop": "pnpm turbo stop",
    "status": "pnpm turbo status",
    "logs": "pnpm turbo logs",
    "lint": "pnpm eslint .",
    "format": "pnpm prettier --write \"packages/web/**\" \"apps/**/platforms/webApp/**\" \"*.{ts,mjs}\"",
    "format-check": "pnpm prettier --check \"packages/web/**\" \"apps/**/platforms/webApp/**\" \"*.{ts,mjs}\""
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "astro-eslint-parser": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-astro": "catalog:",
    "jiti": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-astro": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "workspaces": [
    "packages/web/*",
    "apps/**/platforms/webApp/*"
  ]
}
