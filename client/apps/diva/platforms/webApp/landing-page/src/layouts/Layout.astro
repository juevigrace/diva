---
import '@styles/global.css';
import SharedLayout from 'diva-ui/layouts/layout';
import type { LayoutProps } from 'diva-ui/lib/shared';

type Props = LayoutProps;

const {
  title = 'Diva Landing',
  description = 'Welcome to the Diva ecosystem.',
  bodyClass,
} = Astro.props;
---

<SharedLayout title={title} description={description} bodyClass={bodyClass}>
  <slot />
</SharedLayout>
