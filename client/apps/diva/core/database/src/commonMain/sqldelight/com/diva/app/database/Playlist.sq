upsert:
INSERT OR REPLACE INTO diva_playlist (id, user_id, name, description, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?);

deleteById:
DELETE FROM diva_playlist
WHERE id = ?;

findAll:
SELECT *
FROM diva_playlist
WHERE deleted_at IS NULL
ORDER BY name;

findOneById:
SELECT *
FROM diva_playlist
WHERE id = ? AND deleted_at IS NULL;

findForUser:
SELECT *
FROM diva_playlist
WHERE user_id = ? AND deleted_at IS NULL
ORDER BY name;