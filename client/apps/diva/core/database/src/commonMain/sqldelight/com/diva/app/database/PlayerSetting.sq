upsert:
INSERT OR REPLACE INTO diva_player_setting (user_id, volume, playback_speed, repeat_mode, shuffle, updated_at)
VALUES (?, ?, ?, ?, ?, ?);

findByUser:
SELECT *
FROM diva_player_setting
WHERE user_id = ?;

deleteByUser:
DELETE FROM diva_player_setting
WHERE user_id = ?;

deleteAll:
DELETE FROM diva_player_setting;