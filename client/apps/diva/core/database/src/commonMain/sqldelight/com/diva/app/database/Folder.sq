upsert:
INSERT OR REPLACE INTO diva_folder (id, user_id, name, path, parent_id, scanned_at, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

deleteById:
DELETE FROM diva_folder
WHERE id = ?;

deleteAllByUser:
DELETE FROM diva_folder
WHERE user_id = ?;

findByUser:
SELECT *
FROM diva_folder
WHERE user_id = ? AND deleted_at IS NULL
ORDER BY name;

findById:
SELECT *
FROM diva_folder
WHERE id = ? AND deleted_at IS NULL;

findRoots:
SELECT *
FROM diva_folder
WHERE user_id = ? AND parent_id IS NULL AND deleted_at IS NULL
ORDER BY name;

findChildren:
SELECT *
FROM diva_folder
WHERE user_id = ? AND parent_id = ? AND deleted_at IS NULL
ORDER BY name;

findFolderMedia:
SELECT media.*
FROM diva_media AS media
INNER JOIN diva_media_folder AS link ON link.media_id = media.id
WHERE link.folder_id = ? AND media.deleted_at IS NULL
ORDER BY media.title;