upsert:
INSERT OR REPLACE INTO diva_media
VALUES ?;

deleteAll:
DELETE FROM diva_media;

deleteById:
DELETE FROM diva_media
WHERE id = ?;

findAll:
SELECT *
FROM diva_media
WHERE deleted_at IS NULL
ORDER BY title;

findOneById:
SELECT *
FROM diva_media
WHERE id = ? AND deleted_at IS NULL;

findByType:
SELECT *
FROM diva_media
WHERE media_type = ? AND deleted_at IS NULL
ORDER BY title;

search:
SELECT *
FROM diva_media
WHERE deleted_at IS NULL AND title LIKE '%' || ? || '%'
ORDER BY title;

findByFolder:
SELECT media.*
FROM diva_media AS media
INNER JOIN diva_media_folder AS link ON link.media_id = media.id
WHERE link.folder_id = ? AND media.deleted_at IS NULL
ORDER BY media.title;

findFavorites:
SELECT media.*
FROM diva_media AS media
INNER JOIN diva_favorite AS fav ON fav.media_id = media.id
WHERE media.deleted_at IS NULL
ORDER BY fav.created_at DESC;

findRecent:
SELECT media.*
FROM diva_media AS media
INNER JOIN diva_playback_history AS history ON history.media_id = media.id
WHERE media.deleted_at IS NULL
ORDER BY history.played_at DESC
LIMIT ?;

findResumable:
SELECT media.*, resume.position_ms AS resumePositionMs
FROM diva_media AS media
INNER JOIN diva_resume_point AS resume ON resume.media_id = media.id
WHERE media.deleted_at IS NULL AND resume.position_ms > 0
ORDER BY resume.updated_at DESC;