upsert:
INSERT OR REPLACE INTO diva_resume_point (media_id, position_ms, updated_at)
VALUES (?, ?, ?);

delete:
DELETE FROM diva_resume_point
WHERE media_id = ?;

deleteCompleted:
DELETE FROM diva_resume_point
WHERE position_ms = 0;

findOneByMediaId:
SELECT position_ms AS positionMs
FROM diva_resume_point
WHERE media_id = ?;