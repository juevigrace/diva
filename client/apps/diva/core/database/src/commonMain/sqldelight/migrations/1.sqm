import io.github.juevigrace.diva.lib.models.media.MediaType;
import kotlin.Boolean;

CREATE TABLE IF NOT EXISTS diva_media(
    id TEXT NOT NULL PRIMARY KEY,
    user_id TEXT DEFAULT NULL,
    media_type TEXT AS MediaType NOT NULL,
    title TEXT NOT NULL,
    uri TEXT NOT NULL,
    mime_type TEXT NOT NULL DEFAULT '',
    size_bytes INTEGER NOT NULL DEFAULT 0,
    duration_ms INTEGER DEFAULT NULL,
    fingerprint TEXT DEFAULT NULL UNIQUE,
    created_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    updated_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    deleted_at INTEGER DEFAULT NULL
);

CREATE TABLE IF NOT EXISTS diva_folder(
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    path TEXT NOT NULL UNIQUE,
    parent_id TEXT DEFAULT NULL,
    scanned_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    created_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    updated_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    deleted_at INTEGER DEFAULT NULL,
    FOREIGN KEY(parent_id) REFERENCES diva_folder(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS diva_media_folder(
    media_id TEXT NOT NULL,
    folder_id TEXT NOT NULL,
    created_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    PRIMARY KEY (media_id, folder_id),
    FOREIGN KEY(media_id) REFERENCES diva_media(id) ON DELETE CASCADE,
    FOREIGN KEY(folder_id) REFERENCES diva_folder(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS diva_playlist(
    id TEXT NOT NULL PRIMARY KEY,
    user_id TEXT DEFAULT NULL,
    name TEXT NOT NULL,
    description TEXT NOT NULL DEFAULT '',
    created_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    updated_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    deleted_at INTEGER DEFAULT NULL
);

CREATE TABLE IF NOT EXISTS diva_playlist_item(
    playlist_id TEXT NOT NULL,
    media_id TEXT NOT NULL,
    position INTEGER NOT NULL,
    added_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    PRIMARY KEY (playlist_id, media_id),
    UNIQUE (playlist_id, position),
    FOREIGN KEY(playlist_id) REFERENCES diva_playlist(id) ON DELETE CASCADE,
    FOREIGN KEY(media_id) REFERENCES diva_media(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS diva_media_metadata(
    media_id TEXT NOT NULL PRIMARY KEY,
    album TEXT NOT NULL DEFAULT '',
    artist TEXT NOT NULL DEFAULT '',
    genre TEXT NOT NULL DEFAULT '',
    year INTEGER DEFAULT NULL,
    track_number INTEGER DEFAULT NULL,
    disc_number INTEGER DEFAULT NULL,
    cover_uri TEXT NOT NULL DEFAULT '',
    lyrics TEXT NOT NULL DEFAULT '',
    updated_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    FOREIGN KEY(media_id) REFERENCES diva_media(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS diva_playback_history(
    id TEXT NOT NULL PRIMARY KEY,
    media_id TEXT NOT NULL,
    played_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    position_ms INTEGER NOT NULL DEFAULT 0,
    completed INTEGER AS Boolean NOT NULL DEFAULT 0,
    FOREIGN KEY(media_id) REFERENCES diva_media(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS diva_resume_point(
    media_id TEXT NOT NULL PRIMARY KEY,
    position_ms INTEGER NOT NULL DEFAULT 0,
    updated_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    FOREIGN KEY(media_id) REFERENCES diva_media(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS diva_favorite(
    media_id TEXT NOT NULL PRIMARY KEY,
    created_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    FOREIGN KEY(media_id) REFERENCES diva_media(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS diva_server(
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    base_url TEXT NOT NULL UNIQUE,
    protocol TEXT NOT NULL DEFAULT 'http',
    port INTEGER DEFAULT NULL,
    enabled INTEGER AS Boolean NOT NULL DEFAULT 0,
    last_connected_at INTEGER DEFAULT NULL,
    created_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    updated_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now'))
);

CREATE TABLE IF NOT EXISTS diva_player_setting(
    id TEXT NOT NULL PRIMARY KEY,
    key TEXT NOT NULL UNIQUE,
    value TEXT NOT NULL DEFAULT '',
    updated_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now'))
);