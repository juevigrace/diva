import com.diva.app.models.collection.CollectionType;
import com.diva.app.models.collection.ModerationStatus;
import com.diva.app.models.collection.VisibilityType;
import com.diva.app.models.media.MediaType;
import kotlin.Boolean;

CREATE TABLE IF NOT EXISTS diva_media(
    id TEXT NOT NULL PRIMARY KEY,
    submitted_by TEXT NOT NULL DEFAULT '',
    media_type TEXT AS MediaType NOT NULL,
    title TEXT NOT NULL,
    uri TEXT NOT NULL,
    mime_type TEXT NOT NULL DEFAULT '',
    size_bytes INTEGER NOT NULL DEFAULT 0,
    duration_ms INTEGER DEFAULT NULL,
    width INTEGER NOT NULL DEFAULT 0,
    height INTEGER NOT NULL DEFAULT 0,
    alt_text TEXT NOT NULL DEFAULT '',
    visibility TEXT AS VisibilityType NOT NULL DEFAULT 'PRIVATE',
    sensitive_content INTEGER AS Boolean NOT NULL DEFAULT 0,
    adult_content INTEGER AS Boolean NOT NULL DEFAULT 0,
    published_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    fingerprint TEXT DEFAULT NULL UNIQUE,
    created_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    updated_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    deleted_at INTEGER DEFAULT NULL
);

CREATE TABLE IF NOT EXISTS diva_folder(
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    path TEXT NOT NULL UNIQUE,
    parent_id TEXT DEFAULT NULL,
    scanned_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    created_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    updated_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    deleted_at INTEGER DEFAULT NULL,
    FOREIGN KEY(parent_id) REFERENCES diva_folder(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS diva_media_folder(
    media_id TEXT NOT NULL,
    folder_id TEXT NOT NULL,
    created_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    PRIMARY KEY (media_id, folder_id),
    FOREIGN KEY(media_id) REFERENCES diva_media(id) ON DELETE CASCADE,
    FOREIGN KEY(folder_id) REFERENCES diva_folder(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS diva_tag(
    id TEXT NOT NULL PRIMARY KEY,
    tag_name TEXT NOT NULL,
    created_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    updated_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    deleted_at INTEGER DEFAULT NULL
);

CREATE TABLE IF NOT EXISTS diva_media_tag(
    media_id TEXT NOT NULL,
    tag_id TEXT NOT NULL,
    PRIMARY KEY (media_id, tag_id),
    FOREIGN KEY(media_id) REFERENCES diva_media(id) ON DELETE CASCADE,
    FOREIGN KEY(tag_id) REFERENCES diva_tag(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS diva_collection(
    id TEXT NOT NULL PRIMARY KEY,
    owner_id TEXT NOT NULL DEFAULT '',
    name TEXT NOT NULL,
    description TEXT NOT NULL DEFAULT '',
    collection_type TEXT AS CollectionType NOT NULL,
    visibility TEXT AS VisibilityType NOT NULL DEFAULT 'PRIVATE',
    cover_media_id TEXT DEFAULT NULL,
    created_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    updated_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    deleted_at INTEGER DEFAULT NULL,
    FOREIGN KEY(cover_media_id) REFERENCES diva_media(id) ON DELETE SET NULL
);

CREATE TABLE IF NOT EXISTS diva_collection_media(
    collection_id TEXT NOT NULL,
    media_id TEXT NOT NULL,
    position INTEGER NOT NULL,
    added_by TEXT NOT NULL DEFAULT '',
    score REAL NOT NULL DEFAULT 0.0,
    added_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    PRIMARY KEY (collection_id, media_id),
    UNIQUE (collection_id, position),
    FOREIGN KEY(collection_id) REFERENCES diva_collection(id) ON DELETE CASCADE,
    FOREIGN KEY(media_id) REFERENCES diva_media(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS diva_playlist_metadata(
    collection_id TEXT NOT NULL PRIMARY KEY,
    is_collaborative INTEGER AS Boolean NOT NULL DEFAULT 0,
    allow_suggestions INTEGER AS Boolean NOT NULL DEFAULT 1,
    FOREIGN KEY(collection_id) REFERENCES diva_collection(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS diva_playlist_contributor(
    collection_id TEXT NOT NULL,
    contributor_id TEXT NOT NULL DEFAULT '',
    FOREIGN KEY(collection_id) REFERENCES diva_collection(id) ON DELETE CASCADE,
    PRIMARY KEY (collection_id, contributor_id)
);

CREATE TABLE IF NOT EXISTS diva_playlist_suggestions(
    id TEXT NOT NULL PRIMARY KEY,
    collection_id TEXT NOT NULL,
    suggester_id TEXT NOT NULL DEFAULT '',
    media_id TEXT NOT NULL,
    status TEXT AS ModerationStatus NOT NULL DEFAULT 'PENDING',
    suggested_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    FOREIGN KEY(media_id) REFERENCES diva_media(id) ON DELETE CASCADE,
    FOREIGN KEY(collection_id) REFERENCES diva_collection(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS diva_mix_metadata(
    collection_id TEXT NOT NULL PRIMARY KEY,
    algorithm_type TEXT NOT NULL DEFAULT 'trending',
    time_window_hours INTEGER NOT NULL DEFAULT 24,
    content_weight REAL NOT NULL DEFAULT 0.7,
    freshness_weight REAL NOT NULL DEFAULT 0.3,
    min_engagement_score INTEGER NOT NULL DEFAULT 10,
    excluded_tags TEXT NOT NULL DEFAULT '',
    auto_refresh INTEGER AS Boolean NOT NULL DEFAULT 1,
    refresh_interval_seconds INTEGER NOT NULL DEFAULT 3600,
    FOREIGN KEY(collection_id) REFERENCES diva_collection(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS diva_media_metadata(
    media_id TEXT NOT NULL PRIMARY KEY,
    album TEXT NOT NULL DEFAULT '',
    artist TEXT NOT NULL DEFAULT '',
    genre TEXT NOT NULL DEFAULT '',
    year INTEGER DEFAULT NULL,
    track_number INTEGER DEFAULT NULL,
    disc_number INTEGER DEFAULT NULL,
    cover_uri TEXT NOT NULL DEFAULT '',
    lyrics TEXT NOT NULL DEFAULT '',
    updated_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    FOREIGN KEY(media_id) REFERENCES diva_media(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS diva_playback_history(
    id TEXT NOT NULL PRIMARY KEY,
    media_id TEXT NOT NULL,
    played_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    position_ms INTEGER NOT NULL DEFAULT 0,
    completed INTEGER AS Boolean NOT NULL DEFAULT 0,
    FOREIGN KEY(media_id) REFERENCES diva_media(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS diva_resume_point(
    media_id TEXT NOT NULL PRIMARY KEY,
    position_ms INTEGER NOT NULL DEFAULT 0,
    updated_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    FOREIGN KEY(media_id) REFERENCES diva_media(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS diva_favorite(
    media_id TEXT NOT NULL PRIMARY KEY,
    created_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    FOREIGN KEY(media_id) REFERENCES diva_media(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS diva_server(
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    base_url TEXT NOT NULL UNIQUE,
    protocol TEXT NOT NULL DEFAULT 'http',
    port INTEGER DEFAULT NULL,
    enabled INTEGER AS Boolean NOT NULL DEFAULT 0,
    last_connected_at INTEGER DEFAULT NULL,
    created_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    updated_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now'))
);

CREATE TABLE IF NOT EXISTS diva_player_setting(
    id TEXT NOT NULL PRIMARY KEY,
    key TEXT NOT NULL UNIQUE,
    value TEXT NOT NULL DEFAULT '',
    updated_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now'))
);

CREATE INDEX IF NOT EXISTS idx_diva_media_folder_folder_id ON diva_media_folder (folder_id);
CREATE INDEX IF NOT EXISTS idx_diva_media_folder_media_id ON diva_media_folder (media_id);
CREATE INDEX IF NOT EXISTS idx_diva_media_metadata_artist ON diva_media_metadata (artist);
CREATE INDEX IF NOT EXISTS idx_diva_media_metadata_album ON diva_media_metadata (album);
CREATE INDEX IF NOT EXISTS idx_diva_collection_media_media_id ON diva_collection_media (media_id);
CREATE INDEX IF NOT EXISTS idx_diva_collection_media_collection_id ON diva_collection_media (collection_id);
CREATE INDEX IF NOT EXISTS idx_diva_media_tag_media_id ON diva_media_tag (media_id);
CREATE INDEX IF NOT EXISTS idx_diva_media_tag_tag_id ON diva_media_tag (tag_id);
CREATE INDEX IF NOT EXISTS idx_diva_playlist_suggestions_collection_id ON diva_playlist_suggestions (collection_id);
CREATE INDEX IF NOT EXISTS idx_diva_playlist_contributor_collection_id ON diva_playlist_contributor (collection_id);
CREATE INDEX IF NOT EXISTS idx_diva_playback_history_media_id ON diva_playback_history (media_id);
CREATE INDEX IF NOT EXISTS idx_diva_media_deleted_at ON diva_media (deleted_at);