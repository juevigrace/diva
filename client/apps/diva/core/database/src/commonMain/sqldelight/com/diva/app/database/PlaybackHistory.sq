insert:
INSERT OR REPLACE INTO diva_playback_history (id, user_id, media_id, played_at, position_ms, completed)
VALUES (?, ?, ?, ?, ?, ?);

findRecentByUser:
SELECT media.*
FROM diva_media AS media
INNER JOIN diva_playback_history AS history ON history.media_id = media.id
WHERE history.user_id = ? AND media.deleted_at IS NULL
ORDER BY history.played_at DESC
LIMIT ?;

countCompletedByUser:
SELECT COUNT(*) AS count
FROM diva_playback_history
WHERE user_id = ? AND completed = 1;