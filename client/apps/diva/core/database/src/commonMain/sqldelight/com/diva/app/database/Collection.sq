upsert:
INSERT OR REPLACE INTO diva_collection
VALUES ?;

deleteById:
DELETE FROM diva_collection
WHERE id = ?;

findAll:
SELECT *
FROM diva_collection
WHERE deleted_at IS NULL
ORDER BY name;

findOneById:
SELECT *
FROM diva_collection
WHERE id = ? AND deleted_at IS NULL;

findByType:
SELECT *
FROM diva_collection
WHERE collection_type = ? AND deleted_at IS NULL
ORDER BY name;

findByUser:
SELECT *
FROM diva_collection
WHERE owner_id = ? AND deleted_at IS NULL
ORDER BY name;

findByCover:
SELECT *
FROM diva_collection
WHERE cover_media_id = ? AND deleted_at IS NULL
ORDER BY name;