upsert:
INSERT OR REPLACE INTO diva_collection (
    id, owner_id, name, description, collection_type, visibility,
    cover_media_id, created_at, updated_at, deleted_at
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteById:
DELETE FROM diva_collection
WHERE id = ?;

findAll:
SELECT *
FROM diva_collection
WHERE deleted_at IS NULL
ORDER BY name;

findOneById:
SELECT *
FROM diva_collection
WHERE id = ? AND deleted_at IS NULL;