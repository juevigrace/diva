-- Device filesystem cache for both directories (is_directory = 1) and regular
-- files (is_directory = 0); the file-only columns stay NULL for directories.
-- `id` is an opaque UUID, `path` the absolute device path (globally unique).
-- Kept in sync with `migrations/1.sqm` because `deriveSchemaFromMigrations`
-- is enabled.
CREATE TABLE IF NOT EXISTS diva_directory(
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    path TEXT NOT NULL,
    parent_id TEXT DEFAULT NULL,
    is_directory INTEGER NOT NULL,
    mime_type TEXT DEFAULT NULL,
    size_bytes INTEGER DEFAULT NULL,
    last_modified INTEGER DEFAULT NULL,
    scanned_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    created_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    updated_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    deleted_at INTEGER DEFAULT NULL,
    FOREIGN KEY(parent_id) REFERENCES diva_directory(id) ON DELETE CASCADE,
    UNIQUE (path)
);
