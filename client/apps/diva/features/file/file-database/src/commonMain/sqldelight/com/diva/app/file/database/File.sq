-- File-only columns; dir_id shares its value with the diva_entry row created in
-- the same transaction. Existence here is what marks an entry as a file.

insert:
INSERT INTO diva_file(dir_id, size_bytes, mime_type)
VALUES (?, ?, ?);

update:
UPDATE diva_file
SET size_bytes = ?,
    mime_type = ?
WHERE dir_id = ?;

deleteOne:
DELETE FROM diva_file
WHERE dir_id = ?;

delete:
DELETE FROM diva_file;

findOne:
SELECT dir_id
FROM diva_file
WHERE dir_id = ?;
