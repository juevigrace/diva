upsert:
INSERT OR REPLACE INTO diva_media (
    id, submitted_by, media_type, title, uri, mime_type, size_bytes, duration_ms,
    width, height, alt_text, visibility, sensitive_content, adult_content,
    published_at, fingerprint, created_at, updated_at, deleted_at
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteAll:
DELETE FROM diva_media;

deleteById:
DELETE FROM diva_media
WHERE id = ?;

findAll:
SELECT *
FROM diva_media
WHERE deleted_at IS NULL
ORDER BY title;

findOneById:
SELECT *
FROM diva_media
WHERE id = ? AND deleted_at IS NULL;